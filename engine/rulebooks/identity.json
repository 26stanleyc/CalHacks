{
  "lane": "identity",
  "version": 0,
  "rules": [
    {
      "id": "identity.failed",
      "score": 0.95,
      "description": "Identity mismatch or flagged person behind the agent.",
      "when": {
        "feature": "i_identity_status",
        "op": ">=",
        "value": 2
      }
    },
    {
      "id": "identity.thin_new_principal",
      "score": 0.08,
      "description": "A brand-new person with a thin identity file. Too weak alone; adds to other signals.",
      "when": {
        "all": [
          {
            "feature": "i_identity_status",
            "op": ">=",
            "value": 1
          },
          {
            "feature": "i_principal_age_s",
            "op": "<",
            "value": 600
          }
        ]
      }
    },
    {
      "id": "identity.crs_failed",
      "score": 0.85,
      "description": "The credit bureau says the name, SSN, date of birth and address don't belong to one person.",
      "when": {
        "feature": "i_crs_verified",
        "op": ">=",
        "value": 2
      }
    },
    {
      "id": "identity.crs_high_fraud_risk",
      "score": 0.7,
      "description": "CRS's fraud score for this person is 75 or more out of 100.",
      "when": {
        "feature": "i_crs_fraud_score",
        "op": ">=",
        "value": 75
      }
    },
    {
      "id": "identity.crs_synthetic_shape",
      "score": 0.6,
      "description": "The bureau knows almost nothing about this person, their inbox is under a month old and their phone is prepaid, VoIP or someone else's: the shape of an invented identity.",
      "when": {
        "all": [
          {
            "feature": "i_crs_file_depth",
            "op": "<",
            "value": 0.25
          },
          {
            "feature": "i_crs_email_age_days",
            "op": "<",
            "value": 30
          },
          {
            "feature": "i_crs_phone_risk",
            "op": ">=",
            "value": 1
          }
        ]
      }
    },
    {
      "id": "identity.crs_unverified_thin",
      "score": 0.1,
      "description": "CRS couldn't fully verify this person and holds a thin file on them. Too weak alone; adds to other signals.",
      "when": {
        "all": [
          {
            "feature": "i_crs_verified",
            "op": ">=",
            "value": 1
          },
          {
            "feature": "i_crs_file_depth",
            "op": "<",
            "value": 0.3
          }
        ]
      }
    }
  ]
}
