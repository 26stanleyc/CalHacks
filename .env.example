# Copy this file to .env and fill in real values. .env is gitignored; never commit it.

# --- Apify ---
# Get it at https://console.apify.com/settings/integrations
APIFY_TOKEN=

# --- Coinbase Developer Platform (https://portal.cdp.coinbase.com) ---
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=

# --- Coinbase x402 (Base Sepolia testnet) ---
# Free public testnet facilitator, no API key needed.
X402_FACILITATOR_URL=https://x402.org/facilitator
# Throwaway testnet wallet. Run scripts/make_local_wallet.py to generate and fund one
# (needs `pip install cdp-sdk python-dotenv`).
# Never put a key that controls real funds here.
TESTNET_WALLET_PRIVATE_KEY=
TESTNET_WALLET_ADDRESS=
