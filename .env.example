# Copy this file to .env and fill in real values. .env is gitignored; never commit it.

# --- Apify ---
# Get it at https://console.apify.com/settings/integrations
APIFY_TOKEN=

# --- Coinbase Developer Platform (https://portal.cdp.coinbase.com) ---
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=

# --- Coinbase x402 (Base Sepolia testnet) ---
# Free public testnet facilitator, no API key needed.
X402_FACILITATOR_URL=https://x402.org/facilitator
# Throwaway testnet wallet. Run scripts/make_local_wallet.py to generate and fund one
# (needs `pip install cdp-sdk python-dotenv`).
# Never put a key that controls real funds here.
TESTNET_WALLET_PRIVATE_KEY=
TESTNET_WALLET_ADDRESS=

# --- CRS identity verification (engine/crs.py; sandbox only, never credit pulls) ---
CRS_API_KEY=
CRS_BASE_URL=https://api-sandbox.stitchcredit.com/api
# The sandbox logs in with these (POST /users/login), once per run; failed logins lock the account.
CRS_USERNAME=
CRS_PASSWORD=
# CRS checks on payments whose combined score is in [CRS_BAND_LOW, CRS_BAND_HIGH].
# 0 = off, 1 = mock bureau, live = the real CRS sandbox.
CRS_ESCALATION=0
CRS_BAND_LOW=0.30
CRS_BAND_HIGH=0.70
# A payer who sent no phone or email gets a forward data append only from this score up.
CRS_APPEND_MIN_SCORE=0.50
CRS_MAX_PER_ROUND=20
